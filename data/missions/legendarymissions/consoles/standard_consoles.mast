
#
# This defines the standard consoles for the console selection screen
# Helm, Weapons, Comms, Engineering, Science
# Mainscreen, Cinematic
#
default HELM_CONSOLE_ENABLED = True
default WEAPONS_CONSOLE_ENABLED = True
default ENGINEERING_CONSOLE_ENABLED = True
default COMMS_CONSOLE_ENABLED = True
default SCIENCE_CONSOLE_ENABLED = True
default MAINSCREEN_CONSOLE_ENABLED = True
default CINEMATIC_CONSOLE_ENABLED = True

set_is_console_ship_specific("helm", True)
set_is_console_ship_specific("normal_weap", True)
set_is_console_ship_specific("engineering", True)
set_is_console_ship_specific("science", True)
set_is_console_ship_specific("comms", True)
set_is_console_ship_specific("cinematic", True)
set_is_console_ship_specific("simplemap", True)

#if is_dev_build():
#    gui_tab_add_top("helm,comms,science,weapons,engineering")

@console/helm !0 ^5 "Helm" if HELM_CONSOLE_ENABLED
    " Pilot the ship
    
    GAME_SETUP_DATA = get_game_setup_data()
    VESSEL_TYPES_DATA = get_vessel_types_data()
    player_ship_setup_data = GAME_SETUP_DATA.get_selected_ship(client_id)
    player_ship_type = VESSEL_TYPES_DATA.get_ship_type_from_key(player_ship_setup_data.ship_type_key)
    
    is_jump_drive_active = player_ship_type.has_jump_drive
    
    if not prepare_console("helm", enable_helm_jump_drive_controls=is_jump_drive_active):
        ->END
    await gui_patched()


@console/normal_weap !0 ^10 "Weapons" if WEAPONS_CONSOLE_ENABLED
    " Protect the ship from enemies
    if not prepare_console("normal_weap", widget_list="3dview^main_screen_control^shield_control^ship_data^text_waterfall^weap_beam_freq^weap_beam_speed^weapon_2d_view^weapon_control"):
        ->END
    await gui_patched()


@console/engineering !0 ^15 "Engineering" if ENGINEERING_CONSOLE_ENABLED
    " Keep the ship running optimally
    if not prepare_console("engineering"):
        ->END
    
    player_ship_id = sbs.get_ship_of_client(client_id)
    sbs.send_grid_selection_info(player_ship_id, "", "white", "")
    sel = get_grid_selection(player_ship_id)
    if to_space_object(player_ship_id) is not None:
        if sel is None:
            sel  = 0
        follow_route_select_grid(player_ship_id, sel)
    
    await gui_patched()

@console/comms !0 ^25 "Communication" if COMMS_CONSOLE_ENABLED
    " Interact with other ships and stations
    if not prepare_console("comms"):
        ->END
    
    player_ship_id = sbs.get_ship_of_client(client_id)
    sbs.send_comms_selection_info(player_ship_id, "", "white", "static")
    sel = get_comms_selection(player_ship_id)
    if to_space_object(player_ship_id) is not None:
        if sel is None:
            sel  = 0
        follow_route_select_comms(player_ship_id, sel)
    
    await gui_patched()

@console/science !0 ^20 "Science" if SCIENCE_CONSOLE_ENABLED
    " Discover and provide vital information
    if not prepare_console("science"):
        ->END
    await gui_patched()

@console/cinematic !0 ^35 "Cinematic" if CINEMATIC_CONSOLE_ENABLED
    " The cinematic view of the action
    if not prepare_console("cinematic"):
        ->END
    # TODO should the top tabs even show on the cinematic console?
    # Perhaps there's a way to make them hide temporarily or something?
    
    # Layout to assure it takes up full screen 

    gui_section("area:0,36px,100,100;")
    gui_activate_console("cinematic")
    gui_layout_widget("3dview")
    _ship_id = sbs.get_ship_of_client(client_id)
    set_inventory_value(_ship_id, "cinema_focus", _ship_id)

    if _ship_id is None:
        print("WARNING: cinematic on None player ship")

    sbs.assign_client_to_ship(client_id, _ship_id)
    gui_cinematic_auto(client_id)

    on change get_inventory_value(_ship_id, "cinema_focus"):
        focus_id = get_inventory_value(_ship_id, "cinema_focus", _ship_id)
        if focus_id is not None:
            sbs.assign_client_to_ship(client_id, focus_id)
            gui_cinematic_auto(client_id)

    await gui_patched()

@console/simplemap !0 ^55 "Map"
    " A simple 2d map view
    if not prepare_console("simplemap", widget_list="2dview^radar_zoom_ctrl^ship_data^text_waterfall"):
        ->END
    await gui_patched()
