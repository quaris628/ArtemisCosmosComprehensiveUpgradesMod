
//spawn if can_be_asked_to_surrender(SPAWNED_ID)
    # Check has_surrender_conditions_set_up in case override_surrender_conditions
    # was already called (which might happen if it gets called from another //spawn
    # hook). Override conditions should take precedence over the random defaults
    # that are set up in setup_surrender_conditions.
    if not has_surrender_conditions_set_up(SPAWNED_ID):
        setup_surrender_conditions(SPAWNED_ID)
    ->END

//enable/comms if is_surrendering_comms_allowed(COMMS_ORIGIN_ID, COMMS_SELECTED_ID)

//comms if is_surrendering_comms_allowed(COMMS_ORIGIN_ID, COMMS_SELECTED_ID)
    if has_declared_never_surrender(COMMS_SELECTED_ID):
        last_response_never = " (Last response: Never)"
    else:
        last_response_never = ""
    + "Surrender now{last_response_never}"  handle_surrender_request

===== handle_surrender_request ====
    
    player_ship_object = to_space_object(COMMS_ORIGIN_ID)
    if player_ship_object is None:
        yield fail
    ship_object = to_space_object(COMMS_SELECTED_ID)
    if ship_object is None:
        yield fail
    
    surrender_attempt_result = attempt_surrender(ship_object, player_ship_object)
    
    yield success
    # TODO: Should surrendered ships change sides?

//comms if is_surrendering_comms_allowed(COMMS_ORIGIN_ID, COMMS_SELECTED_ID) and has_code_case(COMMS_ORIGIN_ID)
    # TODO When do the comms buttons refresh when the ship picks up a code case? Immediately? Or does comms need to switch ships? Or even switch consoles? Do I need to add some sort of forced refresh?
    + "Secret Code Case"  //comms/secret_codecase

//comms/secret_codecase if is_surrendering_comms_allowed(COMMS_ORIGIN_ID, COMMS_SELECTED_ID) and has_code_case(COMMS_ORIGIN_ID)
    
    player_ship_object = to_space_object(COMMS_ORIGIN_ID)
    if player_ship_object is None:
        yield fail
    ship_object = to_space_object(COMMS_SELECTED_ID)
    if ship_object is None:
        yield fail
    
    hypothetical_code_case_attempt_result = test_code_caseable(ship_object, player_ship_object)
    if hypothetical_code_case_attempt_result != code_case_attempt_result_success():
        send_comms_response(ship_object.id, player_ship_object, hypothetical_code_case_attempt_result)
        yield fail
    
    + "Back" //comms
    + "Confirm Transmit Codes"  handle_code_case_transmission

===== handle_code_case_transmission ====
    
    player_ship_object = to_space_object(COMMS_ORIGIN_ID)
    if player_ship_object is None:
        yield fail
    ship_object = to_space_object(COMMS_SELECTED_ID)
    if ship_object is None:
        yield fail
    
    code_case_attempt_result = attempt_code_case(ship_object, player_ship_object)
    
    yield success
