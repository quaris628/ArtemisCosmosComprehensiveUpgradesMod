==== gui_library_document_main ====
    document_content = media_read_relative_file("library_docs.amd")
    document_root = document_get_amd_file(None, "Overview", content=document_content)
    document = document_flatten(document_root)
    document_type = "Library"
    document_topic = CONSOLE_SELECT.lower()
    document_back_tab = CONSOLE_SELECT

    gui_switch_to("document_screen")
    ->END

