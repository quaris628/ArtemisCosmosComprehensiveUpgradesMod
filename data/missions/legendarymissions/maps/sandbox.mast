@map/sandbox "Game Master Sandbox"
" An empty map.
" Useful as a blank slate for game masters to set up custom scenarios on, by using the Game Master console to spawn objects.
" To end the game, use the Game Master command 'end game', or set a time limit.
" The upgrades setting still affects the chance that destroying a wreck will drop an upgrade.
metadata:``` yaml
Properties:
  Main:
    Player Ships: 'gui_int_slider("$text:int;low: 1.0;high:8.0;", var= "PLAYER_COUNT")'
    Difficulty: 'gui_int_slider("$text:int;low: 1.0;high:11.0;", var= "DIFFICULTY")'
  Map:
    Terrain: 'gui_text("$text: None;color:#eee;")'
    Lethal Terrain: 'gui_text("$text: None;color:#eee;")'
    Friendly Ships: 'gui_text("$text: None;color:#eee;")'
    Monsters: 'gui_text("$text: None;color:#eee;")'
    Upgrades: 'gui_drop_down("$text: {UPGRADE_SELECT};list: none, few, some, lots, max;color:#eee;", var= "UPGRADE_SELECT")'
    Time Limit: 'gui_input("desc: Minutes;color:#eee;", var="GAME_TIME_LIMIT", listbox_container=map_options_listbox)'
